# Local development (SQLite file inside crm/prisma/)
DATABASE_URL="file:./dev.db"
# Production (Supabase): pooled connection for the app, direct one for schema pushes
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Random long string used to sign login cookies
AUTH_SECRET="change-me-to-a-long-random-string"

# First admin account created by `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin1234"
ADMIN_NAME="Admin"
