// Local development uses SQLite.  `npm run build` rewrites the datasource to
// PostgreSQL (Supabase) when DATABASE_URL starts with "postgres" — see
// scripts/prepare-schema.mjs.  Table and column names are snake_case so the
// Python collector (sync_db.py) can write listings directly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Listing {
  id            String    @id
  site          String
  siteName      String    @map("site_name")
  propertyId    String    @map("property_id")
  link          String?
  title         String?
  dealType      String?   @map("deal_type")
  propertyType  String?   @map("property_type")
  status        String?
  condition     String?
  city          String?
  district      String?
  neighbourhood String?
  address       String?
  ownerType     String?   @map("owner_type")
  ownerName     String?   @map("owner_name")
  phone         String?
  agency        String?
  vip           String?
  description   String?
  image         String?
  images        String? // JSON list of every photo URL (detail page)
  lat           Float?
  lng           Float?
  detailStatus  String?   @map("detail_status")
  posterKind    String?   @map("poster_kind") // owner | agent
  propertyKey   String?   @map("property_key") // deal|area bucket|rooms|place: links copies of one property
  areaM2        Float?    @map("area_m2")
  yardAreaM2    Float?    @map("yard_area_m2")
  priceUsd      Float?    @map("price_usd")
  priceGel      Float?    @map("price_gel")
  pricePerM2Usd Float?    @map("price_per_m2_usd")
  rooms         Int?
  bedrooms      Int?
  bathrooms     Int?
  floor         Int?
  totalFloors   Int?      @map("total_floors")
  postedAt      DateTime? @map("posted_at")
  siteUpdatedAt DateTime? @map("site_updated_at")
  collectedAt   DateTime? @map("collected_at")
  archived      Boolean   @default(false)
  lastSyncAt    DateTime? @map("last_sync_at")

  lead         Lead?
  notes        Note[]
  activities   Activity[]
  priceHistory PriceHistory[]
  publications Publication[]
  shortlists   Shortlist[]
  viewings     Viewing[]
  deals        Deal[]

  @@unique([site, propertyId])
  @@index([postedAt])
  @@index([collectedAt])
  @@index([district])
  @@index([phone])
  @@index([posterKind])
  @@index([propertyKey])
  @@index([archived, collectedAt])
  @@index([archived, posterKind, collectedAt])
  @@index([neighbourhood, dealType])
  @@map("listings")
}

model PriceHistory {
  id        String   @id
  listingId String   @map("listing_id")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  priceUsd  Float?   @map("price_usd")
  seenAt    DateTime @map("seen_at")

  @@index([listingId])
  @@map("price_history")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         String   @default("agent")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  telegramChatId String? @map("telegram_chat_id") // for personal alerts

  leads         Lead[]   @relation("LeadAssignee")
  reposts       Lead[]   @relation("LeadReposter")
  notes         Note[]
  activities    Activity[]
  publications  Publication[]
  clients       Client[]
  viewings      Viewing[]
  deals         Deal[]
  notifications Notification[]
  sharedPosts   SharedPost[]
  alertRules    AlertRule[]
  banners       StreetBanner[]

  @@map("users")
}

model Viewing {
  id          String   @id @default(cuid())
  listingId   String?  @map("listing_id")
  listing     Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  clientId    String?  @map("client_id")
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  agentId     String   @map("agent_id")
  agent       User     @relation(fields: [agentId], references: [id])
  scheduledAt DateTime @map("scheduled_at")
  address     String?
  status      String   @default("planned") // planned | done | cancelled | no_show
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([scheduledAt])
  @@index([agentId])
  @@map("viewings")
}

model Deal {
  id           String    @id @default(cuid())
  listingId    String?   @map("listing_id")
  listing      Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  clientId     String?   @map("client_id")
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  agentId      String    @map("agent_id")
  agent        User      @relation(fields: [agentId], references: [id])
  kind         String // sale | rent | daily
  amount       Float? // deal amount (sale price or monthly rent), USD
  commission   Float? // our commission, USD
  closedAt     DateTime  @map("closed_at")
  note         String?
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([closedAt])
  @@index([agentId])
  @@map("deals")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // match | reminder | system
  title     String
  body      String?
  link      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("notifications")
}

model Lead {
  id           String    @id @default(cuid())
  listingId    String    @unique @map("listing_id")
  listing      Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  status       String    @default("new")
  assignedToId String?   @map("assigned_to_id")
  assignedTo   User?     @relation("LeadAssignee", fields: [assignedToId], references: [id])
  repostedBy   User?     @relation("LeadReposter", fields: [repostedById], references: [id])
  followUpAt   DateTime? @map("follow_up_at")
  priority     Int       @default(0)
  manualPhone  String?   @map("manual_phone") // number an agent found by hand (e.g. MyHome)
  hidden       Boolean   @default(false) // keep off public pages
  repostedId   String?   @map("reposted_id") // id/url of our agent's own copy of this ad
  repostedById String?   @map("reposted_by_id")
  repostedAt   DateTime? @map("reposted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([followUpAt])
  @@index([assignedToId])
  @@index([repostedId])
  @@map("leads")
}

// A listing queued for (re)posting on our own channels with our contact details.
model Publication {
  id           String    @id @default(cuid())
  listingId    String    @map("listing_id")
  listing      Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  channel      String // telegram | facebook | website
  target       String? // channel/chat id, page id or website name
  text         String
  contactPhone String?   @map("contact_phone")
  status       String    @default("queued") // queued | posted | failed | manual | cancelled
  externalId   String?   @map("external_id")
  error        String?
  createdById  String    @map("created_by_id")
  createdBy    User      @relation(fields: [createdById], references: [id])
  createdAt    DateTime  @default(now()) @map("created_at")
  postedAt     DateTime? @map("posted_at")

  @@index([status])
  @@index([listingId])
  @@map("publications")
}

// Tenants/buyers we represent (tourists, expats, Indian community, ...).
model Client {
  id            String    @id @default(cuid())
  name          String
  phone         String?
  messenger     String? // whatsapp / telegram handle
  nationality   String?
  language      String?
  segment       String? // expat | tourist | indian | local | other
  dealType      String?   @map("deal_type") // ქირავდება | იყიდება | ქირავდება დღიურად
  budgetMin     Float?    @map("budget_min")
  budgetMax     Float?    @map("budget_max")
  roomsMin      Int?      @map("rooms_min")
  areas         String? // comma-separated neighbourhoods/districts
  moveIn        DateTime? @map("move_in")
  durationMonths Int?     @map("duration_months")
  notes         String?
  status        String    @default("new") // new | searching | viewing | closed_won | closed_lost
  assignedToId  String?   @map("assigned_to_id")
  assignedTo    User?     @relation(fields: [assignedToId], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  shortlists Shortlist[]
  viewings   Viewing[]
  deals      Deal[]
  sharedPosts SharedPost[]

  @@index([status])
  @@index([segment])
  @@map("clients")
}

model Shortlist {
  id        String   @id @default(cuid())
  clientId  String   @map("client_id")
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  listingId String   @map("listing_id")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  status    String   @default("proposed") // proposed | sent | viewed | liked | rejected | rented
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([clientId, listingId])
  @@map("shortlists")
}

// Our own copy of an ad (imported from myhome.ge / binebi.ge / ... or typed by
// hand) with the agent's contact, sent to a client as a private link.  The
// public page is reachable only through the random token, never by id.
model SharedPost {
  id           String    @id @default(cuid())
  token        String    @unique
  status       String    @default("draft") // draft | published | archived
  sourceUrl    String?   @map("source_url")
  // "waiting": the source page is being fetched by the collector (MyHome);
  // "failed": that fetch did not produce the listing in time.
  importState       String?   @map("import_state")
  importRequestedAt DateTime? @map("import_requested_at")
  listingId    String?   @map("listing_id") // CRM listing it was copied from
  clientId     String?   @map("client_id")
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lang         String    @default("ka") // page labels: ka | en | ru
  title        String
  dealType     String?   @map("deal_type")
  propertyType String?   @map("property_type")
  location     String?
  lat          Float?
  lng          Float?
  mapMode      String    @default("approx") @map("map_mode") // exact | approx (area only) | off
  price        Float?
  currency     String    @default("USD") // USD | GEL
  area         Float?
  rooms        Int?
  bedrooms     Int?
  bathrooms    Int?
  floor        Int?
  totalFloors  Int?      @map("total_floors")
  condition    String?
  description  String?
  contactName  String?   @map("contact_name")
  contactPhone String?   @map("contact_phone")
  views        Int       @default(0)
  lastViewedAt DateTime? @map("last_viewed_at")
  createdById  String    @map("created_by_id")
  createdBy    User      @relation(fields: [createdById], references: [id])
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  photos SharedPostPhoto[]

  @@index([createdById, createdAt])
  @@index([status])
  @@map("shared_posts")
}

// Photos live in the database so the client never sees the source site's
// image URLs (they carry the original listing id).
model SharedPostPhoto {
  id       String     @id @default(cuid())
  postId   String     @map("post_id")
  post     SharedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  position Int        @default(0)
  mime     String
  data     Bytes

  @@index([postId, position])
  @@map("shared_post_photos")
}

// A Telegram chat that receives listing alerts.  Telegram cannot message a
// phone number, so each phone connects once through the bot (/start <code>).
model TelegramRecipient {
  id          String   @id @default(cuid())
  name        String // e.g. "ნინო (599 ...)"
  chatId      String?  @map("chat_id")
  connectCode String   @unique @map("connect_code")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("telegram_recipients")
}

// Saved search: when the collector saves a matching new listing, notify.py
// sends it to the rule's Telegram recipients.
model AlertRule {
  id            String    @id @default(cuid())
  name          String
  active        Boolean   @default(true)
  recipientIds  String    @default("") @map("recipient_ids") // comma-separated TelegramRecipient ids
  dealTypes     String    @default("") @map("deal_types") // comma-separated; empty = any
  propertyTypes String    @default("") @map("property_types")
  areas         String    @default("") // districts and neighbourhoods, comma-separated
  sites         String    @default("")
  posterKind    String    @default("") @map("poster_kind") // owner | agent | "" (any)
  priceMin      Float?    @map("price_min") // USD
  priceMax      Float?    @map("price_max")
  areaMin       Float?    @map("area_min")
  areaMax       Float?    @map("area_max")
  roomsMin      Int?      @map("rooms_min")
  roomsMax      Int?      @map("rooms_max")
  keywords      String    @default("") // any of these words in title/description
  sentCount     Int       @default(0) @map("sent_count")
  lastSentAt    DateTime? @map("last_sent_at")
  createdById   String    @map("created_by_id")
  createdBy     User      @relation(fields: [createdById], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  deliveries AlertDelivery[]

  @@map("alert_rules")
}

// One row per listing sent for a rule, so a listing is never sent twice.
model AlertDelivery {
  id        String    @id @default(cuid())
  ruleId    String    @map("rule_id")
  rule      AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  listingId String    @map("listing_id")
  sentAt    DateTime  @default(now()) @map("sent_at")

  @@unique([ruleId, listingId])
  @@map("alert_deliveries")
}

// A "for sale / for rent" banner an agent saw on the street (owners hang them).
model StreetBanner {
  id            String    @id @default(cuid())
  address       String
  district      String?
  dealType      String?   @map("deal_type")
  propertyType  String?   @map("property_type")
  phone         String?
  phoneDigits   String?   @map("phone_digits") // last 9 digits, for matching
  ownerName     String?   @map("owner_name")
  price         Float?
  comment       String?
  status        String    @default("new") // new | called | interested | listed | rejected
  lat           Float?
  lng           Float?
  createdById   String    @map("created_by_id")
  createdBy     User      @relation(fields: [createdById], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  photos BannerPhoto[]

  @@index([phoneDigits])
  @@index([createdAt])
  @@map("street_banners")
}

model BannerPhoto {
  id       String       @id @default(cuid())
  bannerId String       @map("banner_id")
  banner   StreetBanner @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  mime     String
  data     Bytes

  @@index([bannerId])
  @@map("banner_photos")
}

// Cadastral code (საკადასტრო კოდი) of an address.  Keyed by street + house
// number, so every listing or banner at that address shows the same code.
model CadastralCode {
  id         String   @id @default(cuid())
  addressKey String   @unique @map("address_key")
  address    String // the address it was entered on, for reference
  code       String
  updatedBy  String?  @map("updated_by")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("cadastral_codes")
}

// Free-form settings edited in the CRM (agency phone, public page texts, channel ids).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model Note {
  id        String   @id @default(cuid())
  listingId String   @map("listing_id")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  text      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([listingId])
  @@map("notes")
}

model Activity {
  id        String   @id @default(cuid())
  listingId String?  @map("listing_id")
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  type      String
  detail    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([userId])
  @@map("activities")
}
